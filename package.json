{
  "name": "vectoredit",
  "version": "0.1.0",
  "description": "Vector graphics editor",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "check": "tsc --noEmit && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plawanpawin-byte/vectoredit.git"
  },
  "keywords": [],
  "author": "plawanpawin-byte",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/plawanpawin-byte/vectoredit/issues"
  },
  "homepage": "https://github.com/plawanpawin-byte/vectoredit#readme",
  "private": "true",
  "type": "module",
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "polygon-clipping": "^0.15.7",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.plawanpawin.vectoredit",
    "productName": "VectorEdit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "fileAssociations": [
      {
        "ext": "vedit",
        "name": "VectorEdit document",
        "role": "Editor"
      }
    ]
  }
}
